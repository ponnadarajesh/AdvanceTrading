                    <TextRuns>
                      <TextRun>
                        <Value>= iif(First(Fields!AgentNote.Value, "dsAgentNote")= True,"Upon receipt of this Agent note, the parties shall carefully check the specifications and, upon finding any    differences, shall immediately notify the agent in writing. In the absence of such notice the contract shall be fulfilled in accordance with the terms of this Broker note.","Upon receipt of this Broker note, the parties shall carefully check the specifications and, upon finding any differences, shall immediately notify the agent in writing. In the absence of such notice the contract shall be fulfilled in accordance with the terms of this Broker note.")</Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
