                    <TextRun>
                      <Label>AmendedFrom</Label>
                      <Value>=IIF(Sum(Fields!TradeReference.Value, "dsAgentNote") = 0,"","Amended From Broker Note: " &amp; First(Fields!TradeReference.Value, "dsAgentNote"))</Value>
                      <Style>
