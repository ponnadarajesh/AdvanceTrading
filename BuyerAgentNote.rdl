                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="Textbox8">
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Upon receipt of this agents note, the parties shall carefully check the specifications and, upon finding any    differences, shall immediately notify the agent in writing. In the absence of such notice the contract shall be fulfilled in accordance with the terms of this agent note.</Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Verdana</FontFamily>
                          <FontSize>7pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                </Paragraphs>
